@startuml
!theme spacelab
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 50

title AI-Powered Technical Interview Assistant - System Architecture (Updated)

' --- Actors ---
actor "Recruiter / Candidate" as User

' --- Layers ---
package "Presentation Layer" #aliceblue {
    component [Angular Frontend] as UI #lightblue
}

package "Infrastructure Layer" #whitesmoke {
    component [Eureka Server\n(Discovery - 8761)] as Eureka #lightgrey
    component [API Gateway\n(DGS / GraphQL - 8080)] as Gateway #coral
    component [Message Broker\n(Kafka / RabbitMQ)] as Broker #gold
}

package "Business Logic Layer" #ivory {
    component [Identity Service\n(Auth / RBAC)\n(8081)] as Identity #wheat
    component [Candidate Service\n(Profile / CV)\n(8082)] as Candidate #wheat
    component [Interview Service\n(JD / Scoring)\n(8083)] as Interview #wheat
}

package "Intelligence Layer" #honeydew {
    component [Spring AI / LLM API\n(Gemini / OpenAI)] as AI_Engine #lightgreen
}

package "Data Persistence Layer" #ghostwhite {
    database "Redis (6337)\n(Session / Cache)" as Redis #pink

    database "PostgreSQL (5433)" as DB_Server {
        folder "identity_schema" as ID_DB
        folder "candidate_schema" as CAN_DB
        folder "interview_schema" as INT_DB
    }
}

' --- Layout Positioning ---
Identity -[hidden]right- Candidate
Candidate -[hidden]right- Interview
ID_DB -[hidden]right- CAN_DB
CAN_DB -[hidden]right- INT_DB

' --- Flows & Interactions ---
User --> UI
UI --> Gateway : " GraphQL Query / Mutation "
UI <--> Gateway : " WebSocket (AI Stream) "

' Service Discovery
Gateway <..> Eureka : " Lookup "
Identity .up.> Eureka : " Register "
Candidate .up.> Eureka : " Register "
Interview .up.> Eureka : " Register "

' API Routing & Auth
Gateway -right-> Redis : " Verify Session "
Gateway -down-> Identity : " Route (Login/Register) "
Gateway -down-> Candidate : " Route "
Gateway -down-> Interview : " Route "

Identity -right-> Redis : " Manage Session "

' AI Integration
Interview -right-> AI_Engine : " Prompting / Stream "

' Inter-service Communication
Interview <-left-> Candidate : " FeignClient (Sync) "
Interview -up-> Broker : " Publish Event "
Candidate -up-> Broker : " Consume Event "

' Database Mapping
Identity --down--> ID_DB : " JPA "
Candidate --down--> CAN_DB : " JPA "
Interview --down--> INT_DB : " JPA "

@enduml