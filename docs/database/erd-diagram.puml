@startuml
title TECH INTERVIEW ASSISTANT ERD
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Identity Service (Auth & RBAC)" #E3F2FD {
    entity "User" as user {
        * id : UUID <<PK>>
        --
        * username : String
        * password : String
        * email : String
        * createdAt : Timestamp
    }

    entity "Role" as role {
        * id : Long <<PK>>
        --
        * name : String (ADMIN, RECRUITER, CANDIDATE)
    }

    entity "UserRole" as user_role {
        * user_id : UUID <<FK>>
        * role_id : Long <<FK>>
    }
}

package "Candidate Service" #F1F8E9 {
    entity "Candidate" as candidate {
        * id : UUID <<PK>>
        --
        * user_id : UUID <<FK>>
        * full_name : String
        phone : String
        current_job : String
    }

    entity "Resume" as resume {
        * id : UUID <<PK>>
        --
        * candidate_id : UUID <<FK>>
        file_path : String
        extracted_text : Text (Dùng cho Spring AI)
        uploaded_at : Timestamp
    }

    entity "CandidateSkill" as skill {
        * id : Long <<PK>>
        --
        * candidate_id : UUID <<FK>>
        skill_name : String
        exp_years : Integer
    }
}

package "Interview Service (AI Core)" #FFFDE7 {
    entity "JobDescription" as jd {
        * id : UUID <<PK>>
        --
        * title : String
        * content : Text
        core_skills : String[]
    }

    entity "InterviewSession" as session {
        * id : UUID <<PK>>
        --
        * candidate_id : UUID <<FK>>
        * jd_id : UUID <<FK>>
        * recruiter_id : UUID <<FK>>
        status : String (PENDING, IN_PROGRESS, COMPLETED)
        created_at : Timestamp
    }

    entity "InterviewQuestion" as question {
        * id : UUID <<PK>>
        --
        * session_id : UUID <<FK>>
        question_text : Text
        expected_answer : Text
        ai_generated : Boolean
    }

    entity "InterviewEvaluation" as evaluation {
        * id : UUID <<PK>>
        --
        * question_id : UUID <<FK>>
        candidate_answer : Text
        score : Integer (1-10)
        ai_feedback : Text
    }
}

' Relationships
user "1" -- "*" user_role
role "1" -- "*" user_role

candidate "1" -- "*" resume
candidate "1" -- "*" skill

jd "1" -- "*" session
session "1" -- "*" question
question "1" -- "1" evaluation

' Cross-service references (logical)
user "1" .. "1" candidate : "userId reference"
session "1" .. "1" candidate : "candidateId reference"

@enduml